# Variables de Docker Compose para correr Typing Battle en local. Todas son obligatorias:
# docker-compose.yml no tiene valores por defecto y se detiene si falta alguna.
#
#   Copy-Item .env.example .env      (PowerShell)
#   cp .env.example .env             (bash)
#
# Docker Compose lee .env solo, desde la raíz del repo, y .env no se versiona (.gitignore).
# Los valores de abajo son de ejemplo para desarrollo local: fuera de tu máquina, usa los tuyos.

# ----- MySQL (servicio mysql) -----
# MySQL aplica las contraseñas una sola vez, al crear el volumen de datos. Para cambiarlas después hay que
# borrar los datos (docker compose down -v). Qué más hay que ajustar al cambiarlas: README, «Variables de .env».
MYSQL_ROOT_PASSWORD=typing_root
MYSQL_DATABASE=typing_battle
MYSQL_USER=typing
MYSQL_PASSWORD=typing_dev
# Puerto de MySQL en tu máquina.
MYSQL_PORT=3306

# ----- API (servicio api) -----
# Puerto de la API en tu máquina.
API_PORT=5015
# Orígenes del navegador que pueden llamar a la API: el Shell y el microfrontend.
CORS_SHELL_ORIGIN=http://localhost:4000
CORS_FRONTEND_ORIGIN=http://localhost:4001

# ----- Frontend (servicio frontend) -----
# Puerto del microfrontend en tu máquina: el Shell lo carga desde http://localhost:4001/remoteEntry.js.
FRONTEND_PORT=4001
# URL de la API tal como la usa el navegador (con el puerto de API_PORT). Queda fija al construir la imagen:
# si la cambias, reconstruye con docker compose up -d --build frontend.
TYPING_API_URL=http://localhost:5015

# ----- Solo fuera de Docker (dotnet run, dotnet ef, pruebas y npm) -----
# Docker Compose no las usa: se definen en tu terminal. El código no trae valores por defecto.
#   ConnectionStrings__Typing=Server=localhost;Port=3306;Database=<MYSQL_DATABASE>;User ID=<MYSQL_USER>;Password=<MYSQL_PASSWORD>
#   Cors__AllowedOrigins__0=<origen del Shell, el mismo de CORS_SHELL_ORIGIN>
#   TYPING_TEST_MYSQL=Server=localhost;Port=3306;User ID=root;Password=<MYSQL_ROOT_PASSWORD>;SslMode=Disabled
#   TYPING_API_URL=<la URL de la API que usa el navegador>
