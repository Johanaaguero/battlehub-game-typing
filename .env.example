# Variables de Docker Compose para correr Typing Battle en local.
#
#   Copy-Item .env.example .env      (PowerShell)
#   cp .env.example .env             (bash)
#
# Docker Compose lee .env solo, desde la raíz del repo, y .env no se versiona (.gitignore).
# Si una variable falta o está vacía, docker-compose.yml usa el valor de desarrollo:
# .env solo hace falta para cambiar algún valor o para poner un secreto.

# ----- MySQL (servicio mysql) -----
# Contraseñas solo de desarrollo local: fuera de tu máquina, usa contraseñas propias.
# MySQL las aplica una sola vez, al crear el volumen de datos. Para cambiarlas después hay que
# borrar los datos (docker compose down -v). Qué más hay que ajustar al cambiarlas: README, «Variables de .env».
MYSQL_ROOT_PASSWORD=typing_root
MYSQL_DATABASE=typing_battle
MYSQL_USER=typing
MYSQL_PASSWORD=typing_dev

# ----- API (servicio api) -----
# Las variables vacías usan el valor de desarrollo de docker-compose.yml.
# Orígenes del navegador que pueden llamar a la API. Vacío: http://localhost:4000 (Shell) y http://localhost:4001.
CORS_SHELL_ORIGIN=
CORS_FRONTEND_ORIGIN=

# Aviso de fin de partida a Matchmaking (ADR-004). Vacío: no se avisa.
# Matchmaking corre fuera de este compose; desde el contenedor, tu máquina es host.docker.internal:
#   MATCHMAKING_BASE_URL=http://host.docker.internal:5211
MATCHMAKING_BASE_URL=
# Cliente M2M de Auth0 con el permiso matches.finish: los mismos valores que usa scripts/Start-Integration.ps1
# (el Client ID está en appsettings.Development.json). Domain y Audience vacíos: los de desarrollo.
# El Client Secret es un secreto real: solo va en .env, nunca en el repo.
MATCHMAKING_AUTH0_DOMAIN=
MATCHMAKING_AUTH0_AUDIENCE=
MATCHMAKING_AUTH0_CLIENT_ID=
MATCHMAKING_AUTH0_CLIENT_SECRET=

# ----- Frontend (servicio frontend) -----
# URL de la API tal como la usa el navegador. Vacío: http://localhost:5015.
# Queda fija al construir la imagen: si la cambias, reconstruye con docker compose up -d --build frontend.
TYPING_API_URL=
