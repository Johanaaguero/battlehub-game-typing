# Contexto de build de la imagen de la API (raíz del repo):
#   docker build -f src/backend/TypingBattle.Api/Dockerfile .
# El frontend usa su propio contexto y su propio archivo: src/frontend/.dockerignore.
# A la imagen solo debe llegar el código que se compila: nada local, de pruebas ni secretos.

# Secretos y configuración local
**/.env
**/.env.*
**/appsettings.Local.json
**/*.pem
**/*.key
**/*.pfx
**/*.p12

# Git, CI y editores
.git
.gitignore
.github
.vs
.vscode
.idea
**/*.user

# Resultados de compilación y de pruebas
**/bin
**/obj
**/TestResults
**/*.trx
**/coverage

# Partes del repo que la imagen de la API no necesita
src/frontend
tests
docs
**/*.md
docker-compose*.yml
**/Dockerfile*
.dockerignore
